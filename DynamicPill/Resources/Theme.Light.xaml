<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light Frosted Glass / Acrylic Theme matching rgba(250,250,252,0.82) -->
    <LinearGradientBrush x:Key="PillBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#D8FFFFFF" Offset="0.0" />
        <GradientStop Color="#C8F0F0F4" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PillHoverBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#EAFFFFFF" Offset="0.0" />
        <GradientStop Color="#D6F0F0F4" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PillBorderBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#24000000" Offset="0.0" />
        <GradientStop Color="#10000000" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PillHoverBorderBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#38000000" Offset="0.0" />
        <GradientStop Color="#1E000000" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="PillTitleBrush" Color="#FF1B1B1F" />
    <SolidColorBrush x:Key="PillBodyBrush" Color="#BD1B1B1F" />
    <SolidColorBrush x:Key="PillTimestampBrush" Color="#9E1B1B1F" />

    <!-- Close button for light mode -->
    <SolidColorBrush x:Key="CloseButtonBackgroundBrush" Color="#1F000000" />
    <SolidColorBrush x:Key="CloseButtonHoverBrush" Color="#33000000" />
    <SolidColorBrush x:Key="CloseButtonForegroundBrush" Color="#FF1B1B1F" />

    <!-- Burst Merge Badge -->
    <SolidColorBrush x:Key="BurstBadgeBackgroundBrush" Color="#FF1B1B1F" />
    <SolidColorBrush x:Key="BurstBadgeForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="BurstBadgeBorderBrush" Color="#FFF5F5F7" />

    <Color x:Key="PillShadowColor">#47141828</Color>

    <FontFamily x:Key="PillFontFamily">Segoe UI Variable Text, Segoe UI, Inter, sans-serif</FontFamily>

    <Style x:Key="TitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PillFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PillTitleBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PillFontFamily}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource PillBodyBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
    </Style>

    <Style x:Key="TimestampTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PillFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource PillTimestampBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
    </Style>

</ResourceDictionary>
