<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Translucent Frosted Glass / Deep Acrylic Theme -->
    <LinearGradientBrush x:Key="PillBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#F018181E" Offset="0.0" />
        <GradientStop Color="#E8121216" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PillHoverBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#F5202028" Offset="0.0" />
        <GradientStop Color="#F018181E" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Specular light edge (catching top light) -->
    <LinearGradientBrush x:Key="PillBorderBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#38FFFFFF" Offset="0.0" />
        <GradientStop Color="#12FFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PillHoverBorderBrush" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#55FFFFFF" Offset="0.0" />
        <GradientStop Color="#22FFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="PillTitleBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PillBodyBrush" Color="#BDFFFFFF" />
    <SolidColorBrush x:Key="PillTimestampBrush" Color="#9EFFFFFF" />

    <!-- Close button (24dp circle, background rgba(255,255,255,0.18)) -->
    <SolidColorBrush x:Key="CloseButtonBackgroundBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="CloseButtonHoverBrush" Color="#47FFFFFF" />
    <SolidColorBrush x:Key="CloseButtonForegroundBrush" Color="#FFFFFFFF" />

    <!-- Burst Merge Badge -->
    <SolidColorBrush x:Key="BurstBadgeBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="BurstBadgeForegroundBrush" Color="#FF0B1020" />
    <SolidColorBrush x:Key="BurstBadgeBorderBrush" Color="#E61C1C20" />

    <Color x:Key="PillShadowColor">#50000000</Color>

    <FontFamily x:Key="PillFontFamily">Segoe UI Variable Text, Segoe UI, Inter, sans-serif</FontFamily>

    <Style x:Key="TitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PillFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PillTitleBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PillFontFamily}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource PillBodyBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
    </Style>

    <Style x:Key="TimestampTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PillFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource PillTimestampBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
    </Style>

</ResourceDictionary>
