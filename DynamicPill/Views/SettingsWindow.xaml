<Window x:Class="DynamicPill.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DynamicPill Settings"
        Width="520" Height="620"
        WindowStartupLocation="CenterScreen"
        Background="#181A20"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        ResizeMode="NoResize">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28">
        <StackPanel>
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <Border Width="36" Height="36" CornerRadius="10" Background="#2F66E8" Margin="0,0,14,0">
                    <TextBlock Text="💊" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="DynamicPill Settings" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" />
                    <TextBlock Text="Compact heads-up notifications for Windows" FontSize="12.5" Foreground="#8D93A1" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Card 1: Windows Notification Settings Info -->
            <Border Background="#21242E" CornerRadius="12" Padding="16" Margin="0,0,0,20" BorderBrush="#2D3240" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Native Banner Setup" FontSize="14" FontWeight="SemiBold" Foreground="#9DB8FF" />
                    <TextBlock Text="To hide native Windows square banners while preserving Action Center history, disable banners in Windows Settings."
                               FontSize="12" Foreground="#A8ADB8" TextWrapping="Wrap" Margin="0,4,0,12" LineHeight="17" />
                    <Button Content="Open Windows Notification Settings" Click="OpenWindowsSettings_Click"
                            Padding="12,7" Background="#2F66E8" Foreground="White" BorderThickness="0"
                            FontWeight="SemiBold" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Card 2: Appearance & Theme -->
            <TextBlock Text="Appearance" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,10" />
            <Border Background="#21242E" CornerRadius="12" Padding="16" Margin="0,0,0,20" BorderBrush="#2D3240" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Theme" VerticalAlignment="Center" Foreground="#E2E4E9" FontSize="13" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <RadioButton x:Name="DarkThemeRadio" Content="Dark" IsChecked="True" Foreground="White" Margin="0,0,12,0" Checked="ThemeChanged" />
                            <RadioButton x:Name="LightThemeRadio" Content="Light" Foreground="White" Checked="ThemeChanged" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Display Duration" VerticalAlignment="Center" Foreground="#E2E4E9" FontSize="13" />
                        <TextBlock x:Name="DurationLabel" Text="4.5 s" HorizontalAlignment="Right" Foreground="#9DB8FF" FontSize="13" />
                    </Grid>
                    <Slider x:Name="DurationSlider" Minimum="2" Maximum="10" Value="4.5" SmallChange="0.5" ValueChanged="DurationSlider_ValueChanged" />
                </StackPanel>
            </Border>

            <!-- Card 3: Interactive Tests -->
            <TextBlock Text="Demo &amp; Testing" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,10" />
            <Border Background="#21242E" CornerRadius="12" Padding="16" Margin="0,0,0,20" BorderBrush="#2D3240" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Trigger pill animations instantly to test visuals:" FontSize="12" Foreground="#A8ADB8" Margin="0,0,0,12" />
                    <WrapPanel Margin="0,0,0,0">
                        <Button Content="Test Normal (4.5s)" Click="TestCompact_Click" Padding="12,6" Margin="0,0,8,8" Background="#2B303E" Foreground="White" BorderThickness="0" Cursor="Hand" />
                        <Button Content="Test Rapid Swap" Click="TestSwap_Click" Padding="12,6" Margin="0,0,8,8" Background="#2B303E" Foreground="White" BorderThickness="0" Cursor="Hand" />
                        <Button Content="Test Burst Merge" Click="TestBurst_Click" Padding="12,6" Margin="0,0,8,8" Background="#2B303E" Foreground="White" BorderThickness="0" Cursor="Hand" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Footer -->
            <TextBlock Text="DynamicPill v1.0.0 · Open Source Windows Utility" HorizontalAlignment="Center" Foreground="#5E6370" FontSize="11" Margin="0,10,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
