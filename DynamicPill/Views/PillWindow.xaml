<Window x:Class="DynamicPill.Views.PillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DynamicPill Overlay"
        Width="480" Height="130"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Theme.Dark.xaml" />
                <ResourceDictionary Source="/Resources/Storyboards.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Vector Close Button Style matching 24dp design -->
            <Style x:Key="VectorCloseButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Background" Value="{DynamicResource CloseButtonBackgroundBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Opacity" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="12"
                                    Width="24" Height="24">
                                <Path HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stroke="{DynamicResource CloseButtonForegroundBrush}"
                                      StrokeThickness="2.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M 6,6 L 14,14 M 14,6 L 6,14" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource CloseButtonHoverBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Root layout grid to allow natural symmetrical center expansion -->
    <Grid x:Name="RootGrid" ClipToBounds="False">
        <!-- THE PILL CONTAINER (Initial compact size: 200 x 38 dp; expands on hover to 360 x 64 dp) -->
        <Border x:Name="PillBorder"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Width="200" Height="38"
                CornerRadius="32"
                Background="{DynamicResource PillBackgroundBrush}"
                BorderBrush="{DynamicResource PillBorderBrush}"
                BorderThickness="1"
                Opacity="0"
                RenderTransformOrigin="0.5,0"
                Cursor="Hand"
                MouseEnter="Pill_MouseEnter"
                MouseLeave="Pill_MouseLeave"
                MouseLeftButtonUp="Pill_Click"
                MouseLeftButtonDown="Pill_MouseDown"
                MouseMove="Pill_MouseMove">

            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource PillShadowColor}"
                                  BlurRadius="20"
                                  ShadowDepth="6"
                                  Opacity="0.35"
                                  Direction="270" />
            </Border.Effect>

            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PillScale" ScaleX="1.0" ScaleY="1.0" />
                    <TranslateTransform x:Name="PillTranslate" Y="-80" />
                </TransformGroup>
            </Border.RenderTransform>

            <Grid x:Name="ContentPanel" Margin="12,0,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Column 0: App Icon with optional Burst Badge -->
                <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">

                    <!-- Fallback Icon with App Initial (26x26 compact, 36x36 hover) -->
                    <Border x:Name="FallbackIcon"
                            Width="26" Height="26"
                            CornerRadius="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Visible">
                        <Border.Background>
                            <SolidColorBrush x:Name="FallbackIconBrush" Color="#FF2F66E8" />
                        </Border.Background>
                        <TextBlock x:Name="FallbackInitialText"
                                   Text="M"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <!-- Real App Icon -->
                    <Border x:Name="AppIconHost"
                            Width="26" Height="26"
                            CornerRadius="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ClipToBounds="True"
                            Visibility="Collapsed">
                        <Image x:Name="AppIconImage"
                               Stretch="UniformToFill" />
                    </Border>

                    <!-- Burst Merge Count Badge -->
                    <Border x:Name="BurstBadge"
                            Width="16" Height="16"
                            CornerRadius="8"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,-3,-3,0"
                            Background="{DynamicResource BurstBadgeBackgroundBrush}"
                            BorderBrush="{DynamicResource BurstBadgeBorderBrush}"
                            BorderThickness="1.5"
                            Visibility="Collapsed">
                        <TextBlock x:Name="BurstCountText"
                                   Text="4"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource BurstBadgeForegroundBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- Column 1: Title and expandable Body Text -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,8,0">
                    <TextBlock x:Name="TitleText"
                               Style="{DynamicResource TitleTextStyle}"
                               Text="Maya Chen" />
                    <Border x:Name="BodyHost" Height="0" Opacity="0" ClipToBounds="True">
                        <TextBlock x:Name="BodyText"
                                   Style="{DynamicResource BodyTextStyle}"
                                   Text="Are we still on for the 3 pm review?"
                                   Margin="0,2,0,0" />
                    </Border>
                </StackPanel>

                <!-- Column 2: Timestamp (compact) and Close Button (hover/expanded) -->
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="TimestampText"
                               Style="{DynamicResource TimestampTextStyle}"
                               Text="now" />

                    <Button x:Name="CloseButton"
                            Style="{StaticResource VectorCloseButtonStyle}"
                            Click="CloseButton_Click"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
